        "type": "boolean"
      },
      {
        "key": "tts_backend",
        "label": "TTS 后端",
        "type": "select",
        "options": [
          "local",
          "iflytek_cloud",
          "mimo_cloud"
        ]
      },
      {
        "key": "cloud_tts_fallback_to_local",
