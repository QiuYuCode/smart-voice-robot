digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
VoiceAssistant_Root [label="Ⓜ VoiceAssistant_Root", shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
IdleState_WakeWordDetector [label="IdleState_WakeWordDetector", shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
VoiceAssistant_Root -> IdleState_WakeWordDetector;
ActiveState_Sequence [label="ActiveState_Sequence", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
VoiceAssistant_Root -> ActiveState_Sequence;
Parallel_Interruptible [label="Parallel_Interruptible\nSuccessOnOne", shape=parallelogram, style=filled, fillcolor=gold, fontsize=9, fontcolor=black];
ActiveState_Sequence -> Parallel_Interruptible;
InterruptMonitor [label=InterruptMonitor, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
Parallel_Interruptible -> InterruptMonitor;
DialogLoop_Sequence [label="DialogLoop_Sequence", shape=box, style=filled, fillcolor=orange, fontsize=9, fontcolor=black];
Parallel_Interruptible -> DialogLoop_Sequence;
PlayWakeupSound [label=PlayWakeupSound, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
DialogLoop_Sequence -> PlayWakeupSound;
ListenForCommand [label=ListenForCommand, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
DialogLoop_Sequence -> ListenForCommand;
RecognizeIntent [label=RecognizeIntent, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
DialogLoop_Sequence -> RecognizeIntent;
ActionSelector [label=ActionSelector, shape=octagon, style=filled, fillcolor=cyan, fontsize=9, fontcolor=black];
DialogLoop_Sequence -> ActionSelector;
OpenCameraAction [label=OpenCameraAction, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
ActionSelector -> OpenCameraAction;
QueryWeatherAction [label=QueryWeatherAction, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
ActionSelector -> QueryWeatherAction;
PlayMusicAction [label=PlayMusicAction, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
ActionSelector -> PlayMusicAction;
UnknownCommandResponse [label=UnknownCommandResponse, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
ActionSelector -> UnknownCommandResponse;
PlayResponseSound [label=PlayResponseSound, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
DialogLoop_Sequence -> PlayResponseSound;
CheckDialogTimeout [label=CheckDialogTimeout, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
DialogLoop_Sequence -> CheckDialogTimeout;
ResetDialogState [label=ResetDialogState, shape=ellipse, style=filled, fillcolor=gray, fontsize=9, fontcolor=black];
ActiveState_Sequence -> ResetDialogState;
}
